APP_ENV=development
APP_DEBUG=true

# TigerGraph Savanna / Community Edition. Leave TG_HOST empty to use local graph CSVs.
TG_HOST=
TG_GRAPHNAME=FraudGraph
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
TG_API_TOKEN=
TG_TGCLOUD=true

# Optional. Policy and JSON stay in Python; the model only writes explanations.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
