CREATE LOADING JOB load_fraud_graph FOR GRAPH FraudGraph {
  DEFINE FILENAME customers;
  DEFINE FILENAME cards;
  DEFINE FILENAME transactions;
  DEFINE FILENAME devices;
  DEFINE FILENAME emails;
  DEFINE FILENAME regions;
  DEFINE FILENAME closed_cases;
  DEFINE FILENAME edges;

  LOAD customers TO VERTEX Customer VALUES ($0) USING header="true", separator=",";
  LOAD cards TO VERTEX PaymentCard VALUES ($0, $1, $2, $3) USING header="true", separator=",";
  LOAD transactions TO VERTEX CardTransaction VALUES ($0, $1, $2, $3, $4, $5, $6, $7) USING header="true", separator=",";
  LOAD devices TO VERTEX DeviceProfile VALUES ($0, $1, $2, $3, $4, $5) USING header="true", separator=",";
  LOAD emails TO VERTEX EmailDomain VALUES ($0) USING header="true", separator=",";
  LOAD regions TO VERTEX BillingRegion VALUES ($0, $1) USING header="true", separator=",";
  LOAD closed_cases TO VERTEX ClosedCase VALUES ($0, $1, $2, $3, $4, $5, $6, $7, $8) USING header="true", separator=",";

  LOAD edges TO EDGE OWNS VALUES ($1, $2) WHERE $0 == "owns" USING header="true", separator=",";
  LOAD edges TO EDGE MADE VALUES ($1, $2) WHERE $0 == "made" USING header="true", separator=",";
  LOAD edges TO EDGE FROM_DEVICE VALUES ($1, $2) WHERE $0 == "from_device" USING header="true", separator=",";
  LOAD edges TO EDGE PURCHASER_EMAIL VALUES ($1, $2) WHERE $0 == "purchaser_email" USING header="true", separator=",";
  LOAD edges TO EDGE RECIPIENT_EMAIL VALUES ($1, $2) WHERE $0 == "recipient_email" USING header="true", separator=",";
  LOAD edges TO EDGE BILLED_IN VALUES ($1, $2) WHERE $0 == "billed_in" USING header="true", separator=",";
  LOAD edges TO EDGE NEXT VALUES ($1, $2) WHERE $0 == "next" USING header="true", separator=",";
  LOAD edges TO EDGE INVOLVES VALUES ($1, $2) WHERE $0 == "involves" USING header="true", separator=",";
  LOAD edges TO EDGE ON_CARD VALUES ($1, $2) WHERE $0 == "on_card" USING header="true", separator=",";
  LOAD edges TO EDGE CONNECTED_TO VALUES ($1, $2) WHERE $0 == "connected_to" USING header="true", separator=",";
}
