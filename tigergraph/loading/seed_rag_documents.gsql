USE GRAPH FraudGraph

DROP QUERY seed_rag_insert
DROP QUERY seed_rag_embeddings
DROP QUERY seed_rag_emb

CREATE QUERY seed_rag_insert() FOR GRAPH FraudGraph {
  SumAccum<INT> @@n;
  INSERT INTO RagDocument VALUES ("policy_R1", "R1 Verify before blocking on a weak signal", "If the case rests on a single signal, including a risk score alone, and fraud probability is below 0.70, recommend VERIFY_WITH_CUSTOMER or STEP_UP_AUTH before any block.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R2", "R2 Customer denies", "When the customer denies the transaction, recommend BLOCK_CARD and CREATE_CASE. Add FILE_REPORT when exposure exceeds 1000 USD, a shared device is present, or another card's fraud is connected.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R3", "R3 Customer confirms", "When the customer confirms the transaction, recommend CLOSE_NO_FRAUD and record the confirmation.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R4", "R4 No customer reply", "If the customer does not reply, MONITOR_CARD and DECLINE_TRANSACTION for pending authorizations. Escalate to an analyst when exposure exceeds 500 USD.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R5", "R5 Card testing", "Three or more small online authorizations within one hour followed by a larger purchase: DECLINE_TRANSACTION and STEP_UP_AUTH. If a purchase over 100 USD already cleared, BLOCK_CARD.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R6", "R6 Shared origin", "Several cards with fraud associated with the same device profile, billing region, or recipient email: CREATE_CASE, FILE_REPORT, and MONITOR_CONNECTED_CARDS for every affected card.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R7", "R7 Disputed but legitimate recurring pattern", "If a disputed charge matches the customer's normal recurring pattern: CREATE_CASE, VERIFY_WITH_CUSTOMER, WARN_CUSTOMER. Do not block.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R8", "R8 Uncertain and exposed", "If the case is uncertain with exposure above 500 USD, or evidence conflicts, ESCALATE_TO_ANALYST.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R9", "R9 Coordinated undocumented abuse", "When graph expansion finds coordinated activity that does not match a named pattern, CREATE_CASE, FILE_REPORT, and ESCALATE_TO_ANALYST. Describe how the pattern was discovered.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("policy_R10", "R10 BLOCK_ALL_CARDS", "Only recommend BLOCK_ALL_CARDS if at least two of the customer's cards show confirmed fraud or credentials are confirmed compromised.", "policy");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("pattern_card_testing", "Card testing", "Three or more small online authorizations, often under 5 USD, within about one hour, followed by a larger purchase.", "pattern");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("pattern_card_not_present_fraud", "Card-not-present fraud", "Online activity inconsistent with the cardholder's normal merchants, amounts, or product codes. A burst of a few transactions within 48 hours is common.", "pattern");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("pattern_card_not_present_new_device", "Card-not-present new device", "Same as card-not-present fraud, but the identity record shows a device not previously seen on this account. Stronger evidence, not proof: legitimate customers also use new devices.", "pattern");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("pattern_out_of_region_use", "Out-of-region use", "Card-present activity in a billing region with no prior history, while normal home activity may continue. One new region is not automatically fraud; travel can look the same.", "pattern");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("pattern_account_takeover", "Account takeover", "Mixed-channel behavior inconsistent with the cardholder, often with device and match-flag anomalies. Stolen credentials, not only a stolen card number.", "pattern");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("pattern_undocumented", "Undocumented coordinated activity", "A tight cluster of cards sharing a rare email domain or other origin, without matching card testing, new-device CNP, out-of-region use, or account takeover. Cite the graph hop that found it.", "pattern");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("reg_fincen-sar", "FinCEN suspicious activity report", "A SAR narrative should identify the subject, the dates, the amount, the account or card, and why the activity is suspicious, written so a regulator can review the episode without the rest of the case file. Do not file when the customer confirmed a legitimate purchase.", "regulatory");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("reg_fatf-r10", "FATF customer due diligence", "Financial Action Task Force Recommendation 10 requires ongoing due diligence. A weak single alert is not by itself a reason to block; verify identity and activity first.", "regulatory");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("reg_ffiec-auth", "FFIEC authentication guidance", "FFIEC guidance expects layered authentication. A new device or credential change on an online purchase is a reason to step up authentication, not automatic proof of fraud.", "regulatory");
  @@n += 1;
  INSERT INTO RagDocument VALUES ("reg_ofac-screening", "OFAC screening context", "OFAC screening is separate from fraud typology. Graph investigation of device, email, and region neighbors does not replace sanctions screening and should not be described as OFAC.", "regulatory");
  @@n += 1;
  PRINT @@n;
}

INSTALL QUERY seed_rag_insert
RUN QUERY seed_rag_insert()

CREATE QUERY seed_rag_emb(VERTEX<RagDocument> d, LIST<FLOAT> emb) FOR GRAPH FraudGraph SYNTAX v3 {
  start = {d};
  updated = SELECT s FROM start:s POST-ACCUM (s) s.embedding = emb;
  PRINT updated;
}

INSTALL QUERY seed_rag_emb
RUN QUERY seed_rag_emb("policy_R1", [0.00000000, 0.00000000, 0.00000000, 0.00000000, -0.29196010, 0.00000000, 0.45503692, 0.30050848, -0.26039685, 0.00000000, -0.29590551, 0.00000000, -0.31563254, 0.00000000, 0.00000000, 0.01249379, -0.25973928, 0.18806439, 0.09534733, 0.00000000, 0.01709676, 0.00000000, 0.00000000, 0.00000000, 0.00000000, 0.26499982, -0.28932983, 0.18017358, 0.00723325, 0.17228276, 0.18411898, 0.00000000])
