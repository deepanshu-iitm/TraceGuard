USE GLOBAL

DROP VERTEX Customer

CREATE VERTEX Customer (
  PRIMARY_ID id STRING
)

CREATE VERTEX PaymentCard (
  PRIMARY_ID id STRING,
  card1 STRING,
  network STRING,
  card_type STRING
)

CREATE VERTEX CardTransaction (
  PRIMARY_ID id STRING,
  ts DATETIME,
  amount DOUBLE,
  product_cd STRING,
  channel STRING,
  risk_score DOUBLE,
  billing_region STRING,
  billing_country STRING
)

CREATE VERTEX DeviceProfile (
  PRIMARY_ID id STRING,
  device_type STRING,
  device_info STRING,
  os STRING,
  browser STRING,
  screen STRING
)

CREATE VERTEX EmailDomain (
  PRIMARY_ID id STRING
)

CREATE VERTEX BillingRegion (
  PRIMARY_ID id STRING,
  country STRING
)

CREATE VERTEX ClosedCase (
  PRIMARY_ID id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,
  pattern STRING,
  exposure_usd DOUBLE,
  n_txns UINT,
  report_filed BOOL,
  analyst_notes STRING
)

CREATE VERTEX InvestigationCase (
  PRIMARY_ID id STRING,
  status STRING,
  verdict STRING,
  fraud_probability DOUBLE,
  pattern STRING,
  pattern_description STRING,
  exposure_usd DOUBLE,
  summary STRING,
  stop_reason STRING
)

CREATE DIRECTED EDGE OWNS (FROM Customer, TO PaymentCard)
CREATE DIRECTED EDGE MADE (FROM PaymentCard, TO CardTransaction)
CREATE DIRECTED EDGE FROM_DEVICE (FROM CardTransaction, TO DeviceProfile)
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM CardTransaction, TO EmailDomain)
CREATE DIRECTED EDGE RECIPIENT_EMAIL (FROM CardTransaction, TO EmailDomain)
CREATE DIRECTED EDGE BILLED_IN (FROM CardTransaction, TO BillingRegion)
CREATE DIRECTED EDGE NEXT (FROM CardTransaction, TO CardTransaction)
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO CardTransaction)
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO PaymentCard)
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO PaymentCard)
CREATE DIRECTED EDGE CASE_FOR_CUSTOMER (FROM InvestigationCase, TO Customer)
CREATE DIRECTED EDGE CASE_INVOLVES (FROM InvestigationCase, TO CardTransaction)
CREATE DIRECTED EDGE CASE_ON_CARD (FROM InvestigationCase, TO PaymentCard)
CREATE DIRECTED EDGE CASE_CONNECTED_TO (FROM InvestigationCase, TO PaymentCard)
CREATE DIRECTED EDGE CASE_MATCHES (FROM InvestigationCase, TO ClosedCase)

CREATE GRAPH FraudGraph (
  Customer,
  PaymentCard,
  CardTransaction,
  DeviceProfile,
  EmailDomain,
  BillingRegion,
  ClosedCase,
  InvestigationCase,
  OWNS,
  MADE,
  FROM_DEVICE,
  PURCHASER_EMAIL,
  RECIPIENT_EMAIL,
  BILLED_IN,
  NEXT,
  INVOLVES,
  ON_CARD,
  CONNECTED_TO,
  CASE_FOR_CUSTOMER,
  CASE_INVOLVES,
  CASE_ON_CARD,
  CASE_CONNECTED_TO,
  CASE_MATCHES
)
